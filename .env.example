# Copy to .env (the preflight script does this for you). TRAINING values, not real secrets.
SMS_API_KEY=sk_training_NOT_A_REAL_KEY_123456
JWT_SECRET=training-only-secret-change-me

# Database. With nothing below set, CareDesk uses a local SQLite file (Day 1).
# Day 2 (Lab 4a): fill in the PostgreSQL values your trainer gives you, then uncomment.
# Do NOT also set DATABASE_URL: it would override these.
# PGHOST=<server>.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=caredesk_<alias>
# PGUSER=<your-user>
# PGPASSWORD=<your-password>
# PGSSLMODE=require
